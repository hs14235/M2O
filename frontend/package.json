{
  "name": "meeting-to-issues-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/visual-docker.mjs",
    "test:visual:update": "node scripts/visual-docker.mjs --update",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e"
  },
  "dependencies": {
    "cmdk": "1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^29.1.1",
    "prettier": "3.3.3",
    "typescript": "^5.4.5",
    "vite": "^7.3.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
