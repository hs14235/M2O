FROM node:22-alpine AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit
COPY frontend/ ./
RUN npm run typecheck && npm run build

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY backend/requirements.txt backend/constraints.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home --uid 10001 app
COPY --chown=app:app backend/app ./app
COPY --chown=app:app backend/scripts ./scripts
COPY --chown=app:app backend/migrations ./migrations
COPY --chown=app:app backend/alembic.ini ./
COPY --from=frontend --chown=app:app /build/dist ./static
USER app
EXPOSE 10000
CMD ["python", "-m", "scripts.serve_demo"]
