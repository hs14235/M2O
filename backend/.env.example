# Native development settings. configure_local.py creates a private database URL.
DATABASE_URL=
APP_ENVIRONMENT=development
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
PUBLIC_DEMO_MODE=true
VISITOR_DEMO_ENABLED=true
VISITOR_HOURS=2
VISITOR_ACTIVE_LIMIT=100
VISITOR_RETAINED_LIMIT=500
VISITOR_MUTATION_LIMIT=200
VISITOR_JOB_LIMIT=12
INVITE_HOURS=48
RECOVERY_MINUTES=30
PRIVACY_TOMBSTONE_DAYS=90
EMBED_PROVIDER=hash
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=
MCP_API_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_SCOPES=openid profile
LINKEDIN_PUBLISHING_ENABLED=false
LINKEDIN_API_VERSION=202609
PROVIDER_ENCRYPTION_KEY=
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_APP_ID=
SLACK_SIGNING_SECRET=
# Enable only for an awake endpoint; sleeping Render Free cannot guarantee a 3-second ack.
SLACK_INTERACTIONS_ENABLED=false
